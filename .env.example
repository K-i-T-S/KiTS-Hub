# =============================================================================
# KiTS Hub Environment Configuration
# =============================================================================
# This file contains all environment variables used across the KiTS Hub platform.
# Copy this file to .env and fill in your actual values.
#
# SECURITY NOTES:
# - Never commit this file with real values to version control
# - Use different values for development, staging, and production
# - Keep secrets secure and rotate them regularly
# - Only NEXT_PUBLIC_* variables are exposed to the browser
# =============================================================================

# =============================================================================
# ENVIRONMENT IDENTIFICATION
# =============================================================================

# Node environment (development, production, test)
NODE_ENV=development

# =============================================================================
# APPLICATION URLs AND ENDPOINTS
# =============================================================================

# Main application URL (used for redirects, callbacks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API endpoint URL
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# Supabase project URL (public - exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (public - exposed to browser)
# Used for client-side Supabase operations
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key (SERVER-ONLY - never expose to browser)
# Used for server-side admin operations, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =============================================================================
# DATABASE CONFIGURATION (SERVER-ONLY)
# =============================================================================

# Database connection URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/kits_hub

# Database connection pool size (default: 10)
DATABASE_POOL_SIZE=10

# Database query timeout in milliseconds (default: 30000)
DATABASE_TIMEOUT=30000

# =============================================================================
# REDIS CONFIGURATION (SERVER-ONLY - Optional)
# =============================================================================

# Redis connection URL (optional - used for caching and sessions)
REDIS_URL=redis://localhost:6379

# Redis password (if required)
REDIS_PASSWORD=

# Redis TTL in seconds (default: 3600)
REDIS_TTL=3600

# =============================================================================
# API CONFIGURATION (SERVER-ONLY)
# =============================================================================

# API server port (default: 3000)
API_PORT=3000

# API server host (default: localhost)
API_HOST=localhost

# API request timeout in milliseconds (default: 30000)
API_TIMEOUT=30000

# =============================================================================
# SECURITY CONFIGURATION (SERVER-ONLY)
# =============================================================================

# JWT secret for authentication tokens (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters

# JWT expiration time (default: 7d)
JWT_EXPIRES_IN=7d

# API key secret for API authentication (minimum 16 characters)
API_KEY_SECRET=your-api-key-secret

# Session secret for session management (minimum 32 characters)
SESSION_SECRET=your-session-secret-key-minimum-32-characters

# Session TTL in milliseconds (default: 86400000 = 24 hours)
SESSION_TTL=86400000

# Webhook secret for webhook signature verification (minimum 16 characters)
WEBHOOK_SECRET=your-webhook-secret-key

# Webhook timeout in milliseconds (default: 10000)
WEBHOOK_TIMEOUT=10000

# =============================================================================
# EMAIL CONFIGURATION (SERVER-ONLY - Optional)
# =============================================================================

# SMTP server host
SMTP_HOST=smtp.gmail.com

# SMTP server port (default: 587)
SMTP_PORT=587

# SMTP username
SMTP_USER=your-email@gmail.com

# SMTP password or app password
SMTP_PASS=your-app-password

# From email address
SMTP_FROM=noreply@yourdomain.com

# =============================================================================
# FILE STORAGE CONFIGURATION (SERVER-ONLY - Optional)
# =============================================================================

# AWS Access Key ID for S3 storage
AWS_ACCESS_KEY_ID=your-aws-access-key

# AWS Secret Access Key for S3 storage
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# AWS region (default: us-east-1)
AWS_REGION=us-east-1

# AWS S3 bucket name
AWS_S3_BUCKET=your-s3-bucket-name

# =============================================================================
# PAYMENT CONFIGURATION (SERVER-ONLY - Optional)
# =============================================================================

# Stripe secret key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Stripe webhook secret
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# PayPal client secret
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# =============================================================================
# MONITORING AND LOGGING (SERVER-ONLY)
# =============================================================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log format (json, text)
LOG_FORMAT=json

# Enable metrics collection (true, false)
ENABLE_METRICS=true

# =============================================================================
# RATE LIMITING (SERVER-ONLY)
# =============================================================================

# Rate limit window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW=900000

# Maximum requests per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# CORS CONFIGURATION (SERVER-ONLY)
# =============================================================================

# CORS origin (default: * - be more specific in production)
CORS_ORIGIN=*

# CORS methods (default: GET,POST,PUT,DELETE,OPTIONS)
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# CORS headers (default: Content-Type,Authorization)
CORS_HEADERS=Content-Type,Authorization

# =============================================================================
# BACKUP CONFIGURATION (SERVER-ONLY)
# =============================================================================

# Backup schedule in cron format (default: 0 2 * * * = daily at 2 AM)
BACKUP_SCHEDULE=0 2 * * *

# Backup retention days (default: 30)
BACKUP_RETENTION_DAYS=30

# =============================================================================
# DEVELOPMENT SERVER CONFIGURATION (SERVER-ONLY)
# =============================================================================

# Development server port (default: 3000)
DEV_SERVER_PORT=3000

# Development server host (default: localhost)
DEV_SERVER_HOST=localhost

# Enable hot reload (true, false)
HOT_RELOAD=true

# =============================================================================
# FEATURE FLAGS (PUBLIC - Exposed to browser)
# =============================================================================

# Enable analytics tracking (true, false)
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Enable error reporting (true, false)
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true

# Enable performance monitoring (true, false)
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true

# Enable experimental feature X (true, false)
NEXT_PUBLIC_ENABLE_FEATURE_X=false

# Enable beta features (true, false)
NEXT_PUBLIC_ENABLE_BETA_FEATURES=false

# =============================================================================
# ANALYTICS AND TRACKING (PUBLIC - Exposed to browser)
# =============================================================================

# Google Analytics tracking ID
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# Hotjar site ID
NEXT_PUBLIC_HOTJAR_ID=123456

# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Microsoft Clarity ID
NEXT_PUBLIC_CLARITY_ID=your-clarity-id

# =============================================================================
# MICRO-FRONTEND URLS (PUBLIC - Exposed to browser)
# =============================================================================

# Inventory Management service URL
NEXT_PUBLIC_INVENTORY_URL=http://localhost:4177

# Point of Sale service URL
NEXT_PUBLIC_POS_URL=http://localhost:4178

# CRM System service URL
NEXT_PUBLIC_CRM_URL=http://localhost:4179

# HR Management service URL
NEXT_PUBLIC_HR_URL=http://localhost:4180

# Accounting System service URL
NEXT_PUBLIC_ACCOUNTING_URL=http://localhost:4181

# Analytics Dashboard service URL
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:4182

# =============================================================================
# APPLICATION CONFIGURATION (PUBLIC - Exposed to browser)
# =============================================================================

# Application name
NEXT_PUBLIC_APP_NAME=KiTS Hub

# Application version
NEXT_PUBLIC_APP_VERSION=1.0.0

# Application description
NEXT_PUBLIC_APP_DESCRIPTION=Business Management Platform

# =============================================================================
# UI CONFIGURATION (PUBLIC - Exposed to browser)
# =============================================================================

# Theme (light, dark, auto)
NEXT_PUBLIC_THEME=auto

# Primary color (hex code)
NEXT_PUBLIC_PRIMARY_COLOR=#7c3aed

# Locale (language-region code)
NEXT_PUBLIC_LOCALE=en-US

# =============================================================================
# DEVELOPMENT CONFIGURATION (PUBLIC - Exposed to browser)
# =============================================================================

# Enable development tools (true, false)
NEXT_PUBLIC_DEV_TOOLS=true

# Client-side log level (error, warn, info, debug)
NEXT_PUBLIC_LOG_LEVEL=info

# =============================================================================
# CACHE CONFIGURATION (PUBLIC - Exposed to browser)
# =============================================================================

# Cache TTL in milliseconds (default: 300000 = 5 minutes)
NEXT_PUBLIC_CACHE_TTL=300000

# Enable client-side caching (true, false)
NEXT_PUBLIC_ENABLE_CACHE=true

# =============================================================================
# ENVIRONMENT-SPECIFIC EXAMPLES
# =============================================================================

# Development Environment Example:
# NODE_ENV=development
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# NEXT_PUBLIC_DEV_TOOLS=true
# LOG_LEVEL=debug

# Production Environment Example:
# NODE_ENV=production
# NEXT_PUBLIC_APP_URL=https://app.kitshub.com
# NEXT_PUBLIC_SUPABASE_URL=https://prod-project.supabase.co
# DATABASE_URL=postgresql://user:pass@prod-db.supabase.co:5432/postgres
# NEXT_PUBLIC_DEV_TOOLS=false
# LOG_LEVEL=warn
# CORS_ORIGIN=https://app.kitshub.com

# =============================================================================
# SECURITY CHECKLIST
# =============================================================================
# ✅ No secrets committed to version control
# ✅ Different values for each environment
# ✅ Strong secrets (minimum 32 characters for JWT/SESSION)
# ✅ HTTPS URLs in production
# ✅ Specific CORS origins in production
# ✅ Limited rate limits in production
# ✅ Regular secret rotation
# ✅ Environment-specific configurations
# =============================================================================
