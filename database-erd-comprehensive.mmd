    %% Enhanced Relationships
    products {
        uuid id PK
        uuid tenant_id FK
        string name
        text description
        decimal price
        decimal cost
        string sku UK
        string barcode
        string category
        integer stock_quantity
        integer min_stock_level
        boolean track_batches
        boolean track_expiration
        jsonb variants
        string supplier
        timestamp validity_date
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }
    
    tenants {
        uuid id PK
        string name
        string slug UK
        jsonb settings
        string subscription_plan
        string business_type
        string size
        string currency
        string timezone
        text logo_url
        text industry
        jsonb address
        text contact_phone
        text website
        text tax_id
        jsonb business_registration
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }
    
    tenant_users {
        uuid id PK
        uuid tenant_id FK
        uuid user_id FK
        string role
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }
    
    user_profiles {
        uuid id PK
        uuid user_id FK
        string first_name
        string last_name
        string phone
        text avatar_url
        string timezone
        string language
        text job_title
        text department
        string theme
        boolean email_notifications
        boolean push_notifications
        boolean mfa_enabled
        string mfa_method
        boolean phone_verified
        timestamp onboarding_started_at
        timestamp onboarding_completed_at
        integer onboarding_step
        text[] onboarding_skipped_steps
        timestamp last_login_at
        integer login_count
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }
    
    customers {
        uuid id PK
        uuid tenant_id FK
        string name
        string email UK
        string phone
        jsonb address
        string city
        string state
        string zip_code
        string country
        decimal total_purchases
        integer visit_count
        timestamp last_visit
        uuid preferred_location_id FK
        timestamp created_at
        timestamp updated_at
    }
    
    sales {
        uuid id PK
        uuid tenant_id FK
        uuid customer_id FK
        uuid employee_id FK
        uuid location_id FK
        timestamp sale_date
        decimal subtotal
        decimal tax_amount
        decimal total_amount
        string payment_method
        string payment_status
        jsonb tip_info
        uuid applied_coupon_id FK
        uuid applied_promotion_id FK
        integer loyalty_points_earned
        integer loyalty_points_redeemed
        uuid receipt_template_id FK
        text notes
        timestamp created_at
    }
    
    sale_items {
        uuid id PK
        uuid sale_id FK
        uuid product_id FK
        integer quantity
        decimal unit_price
        decimal total_price
        timestamp created_at
    }
    
    employees {
        uuid id PK
        uuid tenant_id FK
        string name
        string email UK
        string phone
        string role
        decimal commission
        decimal total_sales
        jsonb shifts
        timestamp hire_date
        uuid location_id FK
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }
    
    locations {
        uuid id PK
        uuid tenant_id FK
        string name
        string code UK
        string type
        jsonb address
        jsonb contact_info
        jsonb operating_hours
        string timezone
        boolean is_active
        boolean is_primary
        uuid created_by FK
        timestamp created_at
        timestamp updated_at
    }
    
    suppliers {
        uuid id PK
        uuid tenant_id FK
        string name
        string contact_person
        string email
        string phone
        text address
        string city
        string state
        string zip_code
        string country
        string tax_id
        string payment_terms
        integer lead_time_days
        decimal min_order_amount
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }
    
    product_batches {
        uuid id PK
        uuid tenant_id FK
        uuid product_id FK
        uuid location_id FK
        string batch_number UK
        uuid supplier_id FK
        integer quantity
        integer quantity_reserved
        integer quantity_available GENERATED
        decimal unit_cost
        date manufacture_date
        date expiration_date
        timestamp received_date
        text notes
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }
    
    inventory_by_location {
        uuid id PK
        uuid product_id FK
        uuid product_variant_id FK
        uuid location_id FK
        integer quantity_on_hand
        integer quantity_reserved
        integer quantity_available GENERATED
        integer reorder_level
        integer max_stock
        decimal cost_per_unit
        timestamp last_counted_at
        uuid counted_by FK
        timestamp created_at
        timestamp updated_at
    }
    
    inventory_movements {
        uuid id PK
        uuid product_id FK
        string movement_type
        integer quantity
        uuid batch_id FK
        uuid location_id FK
        uuid transfer_id FK
        uuid reference_id
        text notes
        uuid created_by FK
        timestamp created_at
    }
    
    roles {
        uuid id PK
        string name UK
        text description
        boolean is_system_role
        uuid tenant_id FK
        timestamp created_at
        timestamp updated_at
    }
    
    permissions {
        uuid id PK
        string name UK
        text description
        string resource
        string action
        timestamp created_at
    }
    
    role_permissions {
        uuid id PK
        uuid role_id FK
        uuid permission_id FK
        timestamp created_at
    }
    
    user_roles {
        uuid id PK
        uuid user_id FK
        uuid tenant_id FK
        uuid role_id FK
        uuid assigned_by FK
        timestamp assigned_at
        timestamp expires_at
        boolean is_active
    }
    
    workflows {
        uuid id PK
        uuid tenant_id FK
        string name
        text description
        string trigger_type
        jsonb trigger_config
        jsonb actions
        boolean is_active
        uuid created_by FK
        timestamp created_at
        timestamp updated_at
        timestamp last_run_at
        integer run_count
        integer error_count
    }
    
    workflow_executions {
        uuid id PK
        uuid workflow_id FK
        string status
        timestamp started_at
        timestamp completed_at
        jsonb trigger_data
        jsonb execution_context
        jsonb result
        text error_message
        integer execution_time_ms
    }
    
    api_keys {
        uuid id PK
        uuid tenant_id FK
        string name
        string key_hash UK
        string key_prefix
        jsonb permissions
        integer rate_limit
        boolean is_active
        timestamp expires_at
        timestamp last_used_at
        uuid created_by FK
        timestamp created_at
        timestamp updated_at
    }
    
    webhooks {
        uuid id PK
        uuid tenant_id FK
        string name
        string url
        jsonb events
        string secret
        boolean active
        jsonb retry_config
        jsonb headers
        uuid created_by FK
        timestamp created_at
        timestamp updated_at
        timestamp last_triggered_at
    }
    
    audit_logs {
        uuid id PK
        uuid user_id FK
        uuid tenant_id FK
        uuid session_id FK
        string action
        string resource_type
        uuid resource_id
        jsonb old_values
        jsonb new_values
        inet ip_address
        string user_agent
        timestamp created_at
    }
    
    user_sessions {
        uuid id PK
        uuid user_id FK
        uuid tenant_id FK
        string session_token UK
        jsonb device_info
        inet ip_address
        string user_agent
        boolean is_active
        timestamp last_activity_at
        timestamp expires_at
        timestamp created_at
