# KiTS Hub Monorepo Configuration
# Optimized for npm workspaces with Module Federation architecture (2026 best practices)

# Workspace and hoisting configuration
workspaces=true
legacy-peer-deps=false

# Registry configuration
registry=https://registry.npmjs.org/

# Save exact versions for reproducible builds
save-exact=true

# Shrinkwrap configuration
# Ensures consistent dependency trees across environments
package-lock=true

# Cache configuration for improved performance
cache=/tmp/npm-cache

# Audit configuration for security
audit=true
audit-level=moderate
fund=false

# Logging configuration
loglevel=warn
progress=true

# Network configuration
maxsockets=50

# Engine strictness
engine-strict=true

# Git configuration for workspace packages
git-tag-version=false
