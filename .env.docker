# Environment variables for Docker Compose
# Copy this file to .env and update with your values

# Registry Configuration
REGISTRY=ghcr.io/your-username
IMAGE_NAME=kits-hub
VERSION=latest

# Database Configuration
POSTGRES_USER=kits_user
POSTGRES_PASSWORD=your_secure_password_here

# Application URLs
INVENTORY_URL=https://inventory.kits-hub.com
POS_URL=https://pos.kits-hub.com
CRM_URL=https://crm.kits-hub.com
HR_URL=https://hr.kits-hub.com
ACCOUNTING_URL=https://accounting.kits-hub.com
ANALYTICS_URL=https://analytics.kits-hub.com

# Authentication
NEXTAUTH_SECRET=your_nextauth_secret_here

# Monitoring
GRAFANA_PASSWORD=your_grafana_password_here

# External Services
SNYK_TOKEN=your_snyk_token_here
SLACK_WEBHOOK=your_slack_webhook_here
