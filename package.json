{
  "name": "kits-hub",
  "version": "1.0.0",
  "description": "KiTS Hub - Multi-tenant SaaS platform with 6 standalone solutions",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:inventory\" \"npm run dev:pos\" \"npm run dev:crm\" \"npm run dev:hr\" \"npm run dev:accounting\" \"npm run dev:analytics\" \"npm run dev:shell\"",
    "dev:inventory": "cd solutions/inventory-management && npm run dev",
    "dev:pos": "cd solutions/point-of-sale && npm run dev",
    "dev:crm": "cd solutions/crm-system && npm run dev",
    "dev:hr": "cd solutions/hr-management && npm run dev",
    "dev:accounting": "cd solutions/accounting-system && npm run dev",
    "dev:analytics": "cd solutions/analytics-dashboard && npm run dev",
    "dev:shell": "cd shared-shell && npm run dev",
    "build": "npm run build:inventory && npm run build:pos && npm run build:crm && npm run build:hr && npm run build:accounting && npm run build:analytics && npm run build:shell",
    "build:inventory": "cd solutions/inventory-management && npm run build",
    "build:pos": "cd solutions/point-of-sale && npm run build",
    "build:crm": "cd solutions/crm-system && npm run build",
    "build:hr": "cd solutions/hr-management && npm run build",
    "build:accounting": "cd solutions/accounting-system && npm run build",
    "build:analytics": "cd solutions/analytics-dashboard && npm run build",
    "build:shell": "cd shared-shell && npm run build",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "cd tests && npm run test:unit",
    "test:integration": "cd tests && npm run test:integration",
    "test:e2e": "cd tests && npm run test:e2e",
    "test:module-federation": "cd tests && npm run test:module-federation",
    "test:cross-solution": "cd tests && npm run test:cross-solution",
    "test:performance": "cd tests && npm run test:performance",
    "test:accessibility": "cd tests && npm run test:accessibility",
    "test:security": "cd tests && npm run test:security",
    "test:visual": "cd tests && npm run test:visual",
    "test:coverage": "cd tests && npm run test:coverage",
    "test:inventory": "cd solutions/inventory-management && npm run test",
    "test:pos": "cd solutions/point-of-sale && npm run test",
    "test:crm": "cd solutions/crm-system && npm run test",
    "test:hr": "cd solutions/hr-management && npm run test",
    "test:accounting": "cd solutions/accounting-system && npm run test",
    "test:analytics": "cd solutions/analytics-dashboard && npm run test",
    "lint": "npm run lint:inventory && npm run lint:pos && npm run lint:crm && npm run lint:hr && npm run lint:accounting && npm run lint:analytics && npm run lint:shell",
    "lint:inventory": "cd solutions/inventory-management && npm run lint",
    "lint:pos": "cd solutions/point-of-sale && npm run lint",
    "lint:crm": "cd solutions/crm-system && npm run lint",
    "lint:hr": "cd solutions/hr-management && npm run lint",
    "lint:accounting": "cd solutions/accounting-system && npm run lint",
    "lint:analytics": "cd solutions/analytics-dashboard && npm run lint",
    "lint:shell": "cd shared-shell && npm run lint",
    "type-check": "npm run type-check:inventory && npm run type-check:pos && npm run type-check:crm && npm run type-check:hr && npm run type-check:accounting && npm run type-check:analytics && npm run type-check:shell",
    "type-check:inventory": "cd solutions/inventory-management && npm run type-check",
    "type-check:pos": "cd solutions/point-of-sale && npm run type-check",
    "type-check:crm": "cd solutions/crm-system && npm run type-check",
    "type-check:hr": "cd solutions/hr-management && npm run type-check",
    "type-check:accounting": "cd solutions/accounting-system && npm run type-check",
    "type-check:analytics": "cd solutions/analytics-dashboard && npm run type-check",
    "type-check:shell": "cd shared-shell && npm run type-check",
    "storybook": "cd tests && npm run storybook",
    "storybook:build": "cd tests && npm run storybook:build",
    "install:all": "./scripts/install-dependencies.sh",
    "setup": "npm run install:all && npm run build",
    "start:prod": "concurrently \"npm run start:inventory\" \"npm run start:pos\" \"npm run start:crm\" \"npm run start:hr\" \"npm run start:accounting\" \"npm run start:analytics\" \"npm run start:shell\"",
    "start:inventory": "cd solutions/inventory-management && npm run preview",
    "start:pos": "cd solutions/point-of-sale && npm run preview",
    "start:crm": "cd solutions/crm-system && npm run preview",
    "start:hr": "cd solutions/hr-management && npm run preview",
    "start:accounting": "cd solutions/accounting-system && npm run preview",
    "start:analytics": "cd solutions/analytics-dashboard && npm run preview",
    "start:shell": "cd shared-shell && npm run preview"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "workspaces": [
    "solutions/*"
  ],
  "dependencies": {
    "puppeteer": "^24.34.0"
  }
}
