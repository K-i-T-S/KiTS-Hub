{
  "name": "kits-hub",
  "version": "1.0.0",
  "description": "KiTS Hub - Multi-tenant SaaS platform with 6 standalone solutions",
  "private": true,
  "type": "commonjs",
  "workspaces": [
    "shared-shell",
    "shared/*",
    "solutions/*",
    "business-kits",
    "kits-hub-v2.0",
    "tests"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:shell\" \"npm run dev:inventory\" \"npm run dev:pos\" \"npm run dev:crm\" \"npm run dev:hr\" \"npm run dev:accounting\" \"npm run dev:analytics\"",
    "dev:shell": "npm run dev --workspace=@kits-hub/shared-shell",
    "dev:inventory": "npm run dev --workspace=@kits-hub/inventory-management",
    "dev:pos": "npm run dev --workspace=@kits-hub/point-of-sale",
    "dev:crm": "npm run dev --workspace=@kits-hub/crm-system",
    "dev:hr": "npm run dev --workspace=@kits-hub/hr-management",
    "dev:accounting": "npm run dev --workspace=@kits-hub/accounting-system",
    "dev:analytics": "npm run dev --workspace=@kits-hub/analytics-dashboard",
    "dev:business-kits": "npm run dev --workspace=@kits-hub/business-kits",
    "dev:kits-hub-v2": "npm run dev --workspace=@kits-hub/kits-hub-v2.0",
    "build": "npm run build --workspaces --if-present",
    "build:shell": "npm run build --workspace=@kits-hub/shared-shell",
    "build:inventory": "npm run build --workspace=@kits-hub/inventory-management",
    "build:pos": "npm run build --workspace=@kits-hub/point-of-sale",
    "build:crm": "npm run build --workspace=@kits-hub/crm-system",
    "build:hr": "npm run build --workspace=@kits-hub/hr-management",
    "build:accounting": "npm run build --workspace=@kits-hub/accounting-system",
    "build:analytics": "npm run build --workspace=@kits-hub/analytics-dashboard",
    "build:business-kits": "npm run build --workspace=@kits-hub/business-kits",
    "build:kits-hub-v2": "npm run build --workspace=@kits-hub/kits-hub-v2.0",
    "build:packages": "npm run build --workspaces --workspace=packages/*",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:module-federation": "npm run test:module-federation --workspace=kits-hub-tests",
    "test:cross-solution": "npm run test:cross-solution --workspace=kits-hub-tests",
    "test:performance": "npm run test:performance --workspace=kits-hub-tests",
    "test:accessibility": "npm run test:accessibility --workspace=kits-hub-tests",
    "test:security": "npm run test:security --workspace=kits-hub-tests",
    "test:visual": "npm run test:visual --workspace=kits-hub-tests",
    "test:inventory": "npm run test --workspace=@kits-hub/inventory-management",
    "test:pos": "npm run test --workspace=@kits-hub/point-of-sale",
    "test:crm": "npm run test --workspace=@kits-hub/crm-system",
    "test:hr": "npm run test --workspace=@kits-hub/hr-management",
    "test:accounting": "npm run test --workspace=@kits-hub/accounting-system",
    "test:analytics": "npm run test --workspace=@kits-hub/analytics-dashboard",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "lint:shell": "npm run lint --workspace=@kits-hub/shared-shell",
    "lint:inventory": "npm run lint --workspace=@kits-hub/inventory-management",
    "lint:pos": "npm run lint --workspace=@kits-hub/point-of-sale",
    "lint:crm": "npm run lint --workspace=@kits-hub/crm-system",
    "lint:hr": "npm run lint --workspace=@kits-hub/hr-management",
    "lint:accounting": "npm run lint --workspace=@kits-hub/accounting-system",
    "lint:analytics": "npm run lint --workspace=@kits-hub/analytics-dashboard",
    "type-check": "npm run type-check --workspaces --if-present",
    "typecheck": "tsc --build --verbose",
    "typecheck:watch": "tsc --build --watch --verbose",
    "typecheck:clean": "tsc --build --clean --verbose",
    "storybook": "npm run storybook --workspace=kits-hub-tests",
    "storybook:build": "npm run storybook:build --workspace=kits-hub-tests",
    "start:prod": "concurrently \"npm run start:shell\" \"npm run start:inventory\" \"npm run start:pos\" \"npm run start:crm\" \"npm run start:hr\" \"npm run start:accounting\" \"npm run start:analytics\"",
    "start:shell": "npm run preview --workspace=@kits-hub/shared-shell",
    "start:inventory": "npm run preview --workspace=@kits-hub/inventory-management",
    "start:pos": "npm run preview --workspace=@kits-hub/point-of-sale",
    "start:crm": "npm run preview --workspace=@kits-hub/crm-system",
    "start:hr": "npm run preview --workspace=@kits-hub/hr-management",
    "start:accounting": "npm run preview --workspace=@kits-hub/accounting-system",
    "start:analytics": "npm run preview --workspace=@kits-hub/analytics-dashboard",
    "clean": "npm run clean --workspaces --if-present && rimraf node_modules",
    "clean:deps": "rimraf node_modules && npm install",
    "setup": "npm install && npm run build",
    "audit:fix": "npm audit fix && npm run audit:fix --workspaces",
    "deps:update": "npm update --save && npm run deps:update --workspaces",
    "deps:check": "npm outdated && npm run deps:check --workspaces",
    "deps:analyze": "npm ls --depth=0 --json | node scripts/analyze-dependencies.js",
    "workspaces:list": "npm ls --workspaces --depth=0",
    "workspaces:info": "node scripts/workspace-info.js",
    "workspaces:sync": "node scripts/sync-workspaces.js"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@supabase/supabase-js": "2.49.8",
    "react-router-dom": "6.30.2",
    "lucide-react": "0.487.0",
    "clsx": "2.1.1",
    "class-variance-authority": "0.7.1",
    "tailwind-merge": "2.5.4",
    "zustand": "5.0.9",
    "sonner": "2.0.3",
    "react-hot-toast": "2.6.0",
    "@tanstack/react-query": "5.90.12",
    "zod": "3.25.76",
    "date-fns": "3.6.0",
    "react-hook-form": "7.55.0",
    "recharts": "2.15.2",
    "tailwindcss": "4.1.18",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-toast": "1.2.5",
    "@radix-ui/react-tooltip": "1.1.8",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3"
  },
  "devDependencies": {
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@types/node": "20.10.0",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "@eslint/js": "9.15.0",
    "eslint": "9.15.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "eslint-plugin-security": "3.0.1",
    "typescript": "5.9.3",
    "webpack": "5.97.1",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.2.0",
    "html-webpack-plugin": "5.6.3",
    "ts-loader": "9.5.2",
    "css-loader": "7.1.2",
    "style-loader": "4.0.0",
    "postcss": "8.5.1",
    "postcss-loader": "8.1.1",
    "autoprefixer": "10.4.20",
    "terser-webpack-plugin": "5.3.11",
    "terser": "5.44.1",
    "@babel/preset-env": "7.28.5",
    "@babel/preset-react": "7.28.5",
    "babel-loader": "10.0.0",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "14.5.2",
    "vitest": "4.0.16",
    "@vitest/coverage-v8": "4.0.16",
    "jsdom": "27.3.0",
    "@playwright/test": "1.57.0",
    "playwright": "1.57.0",
    "concurrently": "8.2.2",
    "rimraf": "5.0.5"
  },
  "engines": {
    "node": "20.x || 24.x",
    "npm": "10.x || 11.x"
  },
  "packageManager": "npm@10.0.0",
  "overrides": {
    "@opentelemetry/api": "1.4.1",
    "jspdf": "4.0.0",
    "@tanstack/react-query": "5.90.12",
    "@tanstack/react-query-devtools": "5.91.2",
    "@types/node": "20.10.0",
    "vite": "6.4.1",
    "vitest": "4.0.16",
    "@vitest/coverage-v8": "4.0.16",
    "@vitest/browser-playwright": "4.0.16",
    "jest": "29.7.0",
    "@jest/console": "29.7.0",
    "@jest/core": "29.7.0",
    "@jest/reporters": "29.7.0",
    "@jest/test-result": "29.7.0",
    "jest-runner": "29.7.0",
    "@jest/environment": "29.7.0",
    "@jest/fake-timers": "29.7.0",
    "@jest/globals": "29.7.0",
    "@jest/transform": "29.7.0",
    "ts-jest": "29.4.6",
    "@vitest/mocker": "4.0.16"
  }
}
