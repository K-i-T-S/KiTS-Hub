{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Override noEmit for applications that need compilation output
    // React applications need JavaScript output for bundling
    "noEmit": false,

    // Specify output directory for compiled JavaScript files
    // Bundlers will process these files for production builds
    "outDir": "./dist",

    // Enable code splitting for better performance in micro-frontend architecture
    // Allows lazy loading of solution components on demand
    "module": "ESNext",

    // Preserve JSX for modern React applications with automatic runtime
    // Bundlers will handle JSX transformation for optimal performance
    "jsx": "react-jsx",

    // Enable source maps for production debugging
    // Essential for error tracking in deployed micro-frontends
    "sourceMap": true,

    // Disable declaration generation for applications (only needed for libraries)
    // Reduces build time and output size for application bundles
    "declaration": false,

    // Disable declaration map generation for applications
    // Not needed when declaration generation is disabled
    "declarationMap": false,

    // Enable incremental compilation for faster development builds
    // Critical for hot module replacement in development servers
    "incremental": true,

    // Specify build info file location for incremental compilation
    // Ensures consistent incremental builds across development sessions
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    // Enable experimental decorators for React component metadata
    // Useful for libraries like MobX or custom decorators
    "experimentalDecorators": true,

    // Enable emit metadata for decorators
    // Required for advanced decorator usage in some libraries
    "emitDecoratorMetadata": true,

    // Enable downlevel iteration for older browser support
    // Ensures Symbol.iterator works in compiled JavaScript
    "downlevelIteration": true,

    // Enable strict null checks for enhanced type safety
    // Prevents null/undefined runtime errors in cross-solution communication
    "strictNullChecks": true,

    // Enable strict function types for better type inference
    // Ensures function compatibility across micro-frontend boundaries
    "strictFunctionTypes": true,

    // Enable strict bind call apply for better method binding
    // Prevents context loss issues in event handlers and callbacks
    "strictBindCallApply": true,

    // Enable strict property initialization for class properties
    // Ensures all properties are properly initialized in components
    "strictPropertyInitialization": true,

    // Enable noImplicitAny for maximum type safety
    // Prevents runtime errors from untyped variables in micro-frontend communication
    "noImplicitAny": true,

    // Enable noImplicitReturns for consistent function behavior
    // Ensures all code paths return appropriate values
    "noImplicitReturns": true,

    // Enable noImplicitThis for better context handling
    // Prevents 'this' context issues in event handlers
    "noImplicitThis": true,

    // Enable noUnusedLocals for cleaner code
    // Reduces bundle size by eliminating unused variables
    "noUnusedLocals": true,

    // Enable noUnusedParameters for cleaner function signatures
    // Ensures function parameters are actually used
    "noUnusedParameters": true,

    // Enable exactOptionalPropertyTypes for stricter type checking
    // Prevents undefined values where explicit null is expected
    "exactOptionalPropertyTypes": true,

    // Application-specific path aliases for clean imports
    // Extends base paths with application-specific mappings
    "paths": {
      // Local component imports within the application
      "@/components/*": ["./src/components/*"],
      "@/pages/*": ["./src/pages/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/utils/*": ["./src/utils/*"],
      "@/types/*": ["./src/types/*"],
      "@/assets/*": ["./src/assets/*"],
      "@/styles/*": ["./src/styles/*"],
      "@/config/*": ["./src/config/*"],
      "@/services/*": ["./src/services/*"],
      "@/store/*": ["./src/store/*"],
      
      // Cross-solution imports for micro-frontend architecture
      "@shared-shell/*": ["../shared-shell/src/*"],
      "@shared/ui-components/*": ["../shared/ui-components/src/*"],
      "@shared/integration/*": ["../shared/integration/*"],
      
      // Solution-specific imports for cross-solution communication
      "@inventory/*": ["../solutions/inventory-management/src/*"],
      "@pos/*": ["../solutions/point-of-sale/src/*"],
      "@crm/*": ["../solutions/crm-system/src/*"],
      "@hr/*": ["../solutions/hr-management/src/*"],
      "@accounting/*": ["../solutions/accounting-system/src/*"],
      "@analytics/*": ["../solutions/analytics-dashboard/src/*"]
    }
  },

  // Include application source files and configuration files
  // Ensures comprehensive type checking for the entire application
  "include": [
    "src/**/*",
    "public/**/*",
    "*.config.ts",
    "*.config.js",
    "*.config.cjs",
    ".env.*"
  ],

  // Exclude test files and build artifacts from application compilation
  // Tests use separate TypeScript configuration
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "__tests__/**/*",
    "test/**/*",
    "tests/**/*"
  ],

  // References to shared libraries for project references
  // Enables incremental builds and dependency management
  "references": [
    { "path": "../shared/ui-components" },
    { "path": "../shared/integration/core" }
  ]
}
