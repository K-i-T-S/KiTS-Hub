    products ||--o{ purchase_order_items : ordered
    products ||--o{ stock_transfer_items : transferred
    
    suppliers ||--o{ products : supplies
    suppliers ||--o{ purchase_orders : creates
    locations ||--o{ product_batches : stores
    locations ||--o{ inventory_by_location : tracks
    locations ||--o{ purchase_orders : receives
    locations ||--o{ stock_transfers : from_to
    locations ||--o{ employees : works_at
    locations ||--o{ sales : occurs_at
    
    purchase_orders ||--o{ purchase_order_items : contains
    stock_transfers ||--o{ stock_transfer_items : moves
    
    %% Point of Sale
    tenants ||--o{ sales : processes
    sales ||--o{ sale_items : contains
    sales ||--o{ split_payments : paid_with
    sales ||--o{ tips : includes
    sales ||--o{ inventory_movements : affects
    
    customers ||--o{ sales : makes
    employees ||--o{ sales : processes
    discount_coupons ||--o{ sales : applied_to
    loyalty_programs ||--o{ customer_loyalty_memberships : enrolls
    customer_loyalty_memberships ||--o{ loyalty_transactions : earns
    
    %% CRM System
    tenants ||--o{ customers : serves
    customers ||--o{ customer_communications : communicates_with
    customers ||--o{ customer_interactions : interacts_with
