erDiagram
    %% Multi-Tenant Foundation
    tenants ||--o{ tenant_users : has
    tenants ||--o{ locations : contains
    tenants ||--o{ api_keys : owns
    tenants ||--o{ webhooks : configures
    tenants ||--o{ workflows : automates
    
    %% User Management
    auth.users ||--o{ user_profiles : extends
    auth.users ||--o{ tenant_users : belongs_to
    auth.users ||--o{ user_sessions : creates
    auth.users ||--o{ audit_logs : performs
    auth.users ||--o{ invitations : receives
    
    %% Role-Based Access Control
    roles ||--o{ role_permissions : grants
    roles ||--o{ user_roles : assigned_to
    permissions ||--o{ role_permissions : mapped_to
    
    %% User-Role-Tenant Relationships
    tenant_users }o--|| roles : has
    user_roles }o--|| roles : assigns
    user_roles }o--|| auth.users : for
    user_roles }o--|| tenants : within
    
    %% Inventory Management
    tenants ||--o{ products : owns
