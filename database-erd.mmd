    customers ||--o{ customer_segment_memberships : belongs_to
    customers ||--o{ customer_loyalty_memberships : joins
    
    marketing_campaigns ||--o{ campaign_deliveries : delivers
    marketing_campaigns ||--o{ customer_segments : targets
    customer_segments ||--o{ customer_segment_memberships : contains
    loyalty_programs ||--o{ loyalty_rewards : offers
    
