    %% Relationships with cardinality
    tenants {
        uuid id PK
        string name
        string slug UK
        string subscription_plan
        jsonb settings
        boolean is_active
        string business_type
        string size
        string currency
        string timezone
        timestamp created_at
        timestamp updated_at
    }
    
    auth.users {
        uuid id PK
        string email UK
        timestamp created_at
    }
    
    user_profiles {
        uuid id PK
        uuid user_id FK
        string first_name
        string last_name
        string phone
        string avatar_url
        string timezone
        string language
        boolean mfa_enabled
        timestamp onboarding_completed_at
        integer onboarding_step
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }
    
    tenant_users {
        uuid id PK
        uuid tenant_id FK
        uuid user_id FK
        string role
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }
    
    roles {
        uuid id PK
        string name UK
        string description
        boolean is_system_role
        uuid tenant_id FK
        timestamp created_at
        timestamp updated_at
    }
    
    permissions {
        uuid id PK
        string name UK
        string description
        string resource
        string action
        timestamp created_at
    }
    
    role_permissions {
        uuid id PK
        uuid role_id FK
        uuid permission_id FK
        timestamp created_at
    }
    
    user_roles {
        uuid id PK
        uuid user_id FK
        uuid tenant_id FK
        uuid role_id FK
        timestamp assigned_at
        timestamp expires_at
        boolean is_active
    }
    
    products {
        uuid id PK
        uuid tenant_id FK
        string name
        text description
        decimal price
        decimal cost
        string sku
        string barcode
        string category
        integer stock_quantity
        integer min_stock_level
        boolean track_batches
        boolean track_expiration
        jsonb variants
        string supplier
        timestamp validity_date
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }
    
    customers {
        uuid id PK
        uuid tenant_id FK
        string name
        string email
        string phone
        text address
        decimal total_purchases
        integer visit_count
        timestamp last_visit
        uuid preferred_location_id FK
        timestamp created_at
        timestamp updated_at
    }
    
    employees {
        uuid id PK
        uuid tenant_id FK
        string name
        string email
        string phone
        string role
        decimal commission
        decimal total_sales
        jsonb shifts
        uuid location_id FK
        boolean is_active
        timestamp hire_date
        timestamp created_at
        timestamp updated_at
    }
    
    sales {
        uuid id PK
        uuid tenant_id FK
        uuid customer_id FK
        uuid employee_id FK
        uuid location_id FK
        timestamp sale_date
        decimal subtotal
        decimal tax_amount
        decimal total_amount
        string payment_method
        string payment_status
        jsonb tip_info
        uuid applied_coupon_id FK
        integer loyalty_points_earned
        text notes
        timestamp created_at
    }
    
    locations {
        uuid id PK
        uuid tenant_id FK
        string name
        string code UK
        string type
        jsonb address
        jsonb operating_hours
        string timezone
        boolean is_active
        boolean is_primary
        timestamp created_at
        timestamp updated_at
    }
    
    suppliers {
        uuid id PK
        uuid tenant_id FK
        string name
        string contact_person
        string email
        string phone
        text address
        string tax_id
        string payment_terms
        integer lead_time_days
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }
    
    product_batches {
        uuid id PK
        uuid tenant_id FK
        uuid product_id FK
        uuid location_id FK
        string batch_number
        uuid supplier_id FK
        integer quantity
        integer quantity_reserved
        decimal unit_cost
        date manufacture_date
        date expiration_date
        timestamp received_date
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }
    
    purchase_orders {
        uuid id PK
        uuid tenant_id FK
        uuid supplier_id FK
        uuid location_id FK
        string order_number UK
        string status
        timestamp order_date
        date expected_date
        timestamp received_date
        decimal subtotal
        decimal tax_amount
        decimal total_amount
        text notes
        timestamp created_at
        timestamp updated_at
    }
    
    sale_items {
        uuid id PK
        uuid sale_id FK
        uuid product_id FK
        integer quantity
        decimal unit_price
        decimal total_price
        timestamp created_at
    }
    
    workflows {
        uuid id PK
        uuid tenant_id FK
        string name
        text description
        string trigger_type
        jsonb trigger_config
        jsonb actions
        boolean is_active
        timestamp created_at
        timestamp updated_at
        timestamp last_run_at
        integer run_count
        integer error_count
    }
    
    api_keys {
        uuid id PK
        uuid tenant_id FK
        string name
        string key_hash UK
        string key_prefix
        jsonb permissions
        integer rate_limit
        boolean is_active
        timestamp expires_at
        timestamp last_used_at
        timestamp created_at
        timestamp updated_at
    }
    
    webhooks {
        uuid id PK
        uuid tenant_id FK
        string name
        string url
        jsonb events
        string secret
        boolean active
        jsonb retry_config
        timestamp created_at
        timestamp updated_at
        timestamp last_triggered_at
    }
    
    user_sessions {
        uuid id PK
        uuid user_id FK
        uuid tenant_id FK
        string session_token UK
        jsonb device_info
        inet ip_address
        text user_agent
        boolean is_active
        timestamp last_activity_at
        timestamp expires_at
        timestamp created_at
    }
    
    audit_logs {
        uuid id PK
        uuid user_id FK
        uuid tenant_id FK
        uuid session_id FK
        string action
        string resource_type
        uuid resource_id
        jsonb old_values
        jsonb new_values
        inet ip_address
        text user_agent
        timestamp created_at
    }
