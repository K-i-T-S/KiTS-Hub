{
  "name": "@kits-hub/inventory-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "KiTS Inventory Management - Standalone SaaS solution for multi-location inventory tracking",
  "scripts": {
    "dev": "webpack serve --config webpack.config.cjs --mode development",
    "build": "webpack --config webpack.config.cjs --mode production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}' --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preview": "webpack serve --config webpack.config.cjs --mode production",
    "start:prod": "npm run build && npx serve dist -p 4177"
  },
