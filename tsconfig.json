  "compilerOptions": {
    // Enable incremental compilation for faster builds across all projects
    // Essential for development performance in micro-frontend architecture
    // Impact: Dramatically improves build times for large monorepos
    "incremental": true,
    
    // Enable composite project mode for project references
    // Required for TypeScript project references to work properly
    // Impact: Enables proper dependency management and incremental builds
    "composite": true,
    
    // Disable verbose output for cleaner build logs
    // Reduces noise in build output while maintaining error reporting
    // Impact: Better developer experience during builds
    "verbose": false,
    
    // Specify build info file location for incremental compilation
    // Central location for build cache across the entire monorepo
    // Impact: Consistent incremental builds across development sessions
    "tsBuildInfoFile": "./.tsbuildinfo"
  }
}
