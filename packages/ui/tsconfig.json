{
  // TypeScript configuration for UI components library
  // Extends base library configuration with UI-specific settings
  "extends": "../../tsconfig.lib.json",
  
  "compilerOptions": {
    // UI library-specific path aliases for clean imports
    // Extends base paths with UI library specific mappings
    "paths": {
      // Internal UI component imports
      "@/components/*": ["./src/components/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/utils/*": ["./src/utils/*"],
      "@/types/*": ["./src/types/*"],
      "@/assets/*": ["./src/assets/*"],
      "@/styles/*": ["./src/styles/*"],
      "@/config/*": ["./src/config/*"],
      "@/stories/*": ["./src/stories/*"],
      
      // Cross-library imports for shared dependencies
      "@shared/integration/*": ["../../shared/integration/*"],
      
      // Solution-specific imports for cross-solution compatibility
      "@shell/*": ["../../shared-shell/src/*"],
      "@inventory/*": ["../../solutions/inventory-management/src/*"],
      "@pos/*": ["../../solutions/point-of-sale/src/*"],
      "@crm/*": ["../../solutions/crm-system/src/*"],
      "@hr/*": ["../../solutions/hr-management/src/*"],
      "@accounting/*": ["../../solutions/accounting-system/src/*"],
      "@analytics/*": ["../../solutions/analytics-dashboard/src/*"]
    }
  },
  
  // Include UI library source files and configuration
  "include": [
    "src/**/*",
    "*.config.*",
    "**/*.config.*",
    "package.json"
  ],
  
  // Exclude test files and build artifacts
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "**/*.test.*",
    "**/*.spec.*",
    "__tests__/**/*",
    "test/**/*",
    "storybook-static/**/*"
  ],
  
  // Enable composite project for project references
  "composite": true
}
