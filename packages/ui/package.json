    "test": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": ["react", "typescript", "ui", "components", "design-system", "tailwind", "micro-frontend"],
  "author": "KiTS Hub Team",
