{
  "name": "@kits-hub/ui",
  "version": "1.0.0",
  "description": "Shared UI component library for KiTS Hub micro-frontend architecture",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit",
