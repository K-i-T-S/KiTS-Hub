{
  "name": "@kits-hub/shared-shell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "KiTS Hub Shared Shell - Host application for micro-frontend architecture",
  "scripts": {
    "dev": "webpack serve --config webpack.simple.cjs --mode development",
    "dev:original": "webpack serve --config webpack.config.cjs --mode development",
    "build": "webpack --mode production",
    "build:working": "webpack --config webpack.working.cjs --mode production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}' --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "webpack serve --config webpack.working.cjs --mode development --port 3000",
    "preview": "webpack serve --mode production --port 3000",
    "simple": "webpack serve --config webpack.simple.cjs --mode development --port 3000",
    "mf": "webpack serve --config webpack.mf-fixed.cjs --mode development --port 3000"
  },
  "dependencies": {
    "jspdf": "4.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.55.1",
    "@swc/core-linux-x64-gnu": "1.15.8",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "terser-webpack-plugin": "^5.3.11",
    "ts-loader": "9.5.4",
    "webpack-dev-server": "5.2.2"
  },
  "engines": {
    "node": "24.x"
  }
}
